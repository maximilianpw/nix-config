          "legendFormat": "{{provider}} {{account}} resets",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "title": "7-day quota: time left at current pace vs reset",
      "type": "bargauge",
      "description": "If an account runs out before it resets, you will hit the limit at the last 6 hours' pace. Accounts with no recent usage have no 'runs out' bar."
    },
