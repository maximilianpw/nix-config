# Package overlays applied to every host and to the flake's package outputs:
# agent CLIs from llm-agents, selected packages from nixpkgs-unstable, version
# pins, and the repository-built packages under packages/.
inputs: [
  inputs.fenix.overlays.default
  inputs.vite-plus.overlays.default
  (_: prev: let
    llm = inputs.llm-agents.packages.${prev.stdenv.hostPlatform.system};
    resignBunBinary = package: binaryPath:
      if prev.stdenv.hostPlatform.isDarwin
      then
        package.overrideAttrs (old: {
          # Nix rewrites Bun's Mach-O dependencies during fixup, which
          # invalidates the embedded signature and makes macOS kill it.
          nativeBuildInputs =
            (old.nativeBuildInputs or [])
            ++ [prev.darwin.sigtool];
          postFixup =
            (old.postFixup or "")
            + ''
              codesign --force --sign - "$out/${binaryPath}"
            '';
        })
      else package;
    # hunk's executable is wrapped at $out/bin/hunk; sign the actual
    # Mach-O payload instead of the shell wrapper generated by Nix.
    hunk = resignBunBinary llm.hunk "share/hunk/bin/hunk";
    pi = resignBunBinary llm.pi "libexec/pi/pi";
    # llm-agents' offline bun2nix install skips Bun's patchedDependencies, so
    # the review UI calls a missing `refreshRows()` from the patched
    # @pierre/trees and renders a blank page. Apply upstream's patches/ here.
    plannotator = llm.plannotator.overrideAttrs (old: {
      preBuild =
        (old.preBuild or "")
        + ''
          for patchFile in patches/*.patch; do
            spec=$(basename "$patchFile" .patch)
            spec=''${spec//%2F//}
            patchedName=''${spec%@*}
            patchedVersion=''${spec##*@}
            found=0
            for dir in node_modules/.bun/"''${patchedName//\//+}@$patchedVersion"*/node_modules/"$patchedName"; do
              [ -d "$dir" ] || continue
              found=1
              chmod -R u+w "$dir"
              if patch -d "$dir" -p1 -R --dry-run --silent < "$patchFile" > /dev/null; then
                continue
              fi
              patch -d "$dir" -p1 --forward < "$patchFile"
            done
            if [ "$found" = 0 ]; then
              echo "no installed $patchedName@$patchedVersion for $patchFile" >&2
              exit 1
            fi
          done
        '';
    });
  in {
    inherit (llm) claude-code;
    inherit (llm) codex;
    # llm-agents keeps v1 as opencode; v2 installs the command `opencode2`.
    # modules/cliproxyapi/home.nix provides the `opencode` command.
    inherit (llm) opencode2;
    cliproxyapi = llm.cli-proxy-api;
    inherit (llm) grok;
    inherit (llm) executor;
    amp-cli = llm.amp;
    inherit pi;
    plannotator = resignBunBinary plannotator "bin/plannotator";
    inherit (llm) skills;
    hunkdiff = hunk;
  })
  (final: prev: let
    unstable = inputs.nixpkgs-unstable.legacyPackages.${prev.stdenv.hostPlatform.system};
  in {
    # Expose the full unstable channel for consumers that need a single
    # unstable package without shadowing the stable one globally (which
    # would force mass rebuilds of everything depending on it).
    inherit unstable;
    # The legacy Equinox host returns 403; ngrok's host serves the same
    # pinned artifacts. Keep the version and hash until nixpkgs migrates.
    ngrok = prev.ngrok.overrideAttrs (old: {
      src = old.src.overrideAttrs (src: {
        urls = map (builtins.replaceStrings ["https://bin.equinox.io/"] ["https://bin.ngrok.com/"]) src.urls;
      });
    });
    # Cloudflared requires Go 1.27.4; scope the toolchain pin to this package
    # rather than moving unstable for every host or allowing Go to download it.
    cloudflared = let
      go = unstable.go_1_27.overrideAttrs (_: {
        version = "1.27.4";
        src = prev.fetchurl {
          url = "https://go.dev/dl/go1.27.4.src.tar.gz";
          hash = "sha256-c8+4VxrsDAEXdofbhxY9Rqog6XeWcncokaoXZU2aYJk=";
        };
      });
    in
      (unstable.cloudflared.override {
        buildGo127Module = unstable.buildGo127Module.override {inherit go;};
      }).overrideAttrs (_: let
        version = "2026.11.2";
      in {
        inherit version;
        src = prev.fetchFromGitHub {
          owner = "cloudflare";
          repo = "cloudflared";
          tag = version;
          hash = "sha256-j0WVmn7XMLla31yBn3K1rmeCexSQTWrgm4xtaEBiJAw=";
        };
        vendorHash = "sha256-l5dvI3C8eQKcF6zACHIOud5KWfIRkdZNoVEPRR9Oxt0=";
      });
    # direnv 2.37.1 fish tests get killed during build on macOS (sandbox/OOM)
    direnv = prev.direnv.overrideAttrs (_: {doCheck = false;});
    # Home Assistant integrations move on a monthly cadence, so keep Core
    # and its declarative extensions on the same current package set.
    inherit
      (unstable)
      home-assistant
      home-assistant-custom-lovelace-modules
      jujutsu
      ;
    helium = final.callPackage ./packages/helium.nix {};
    tunarr = final.callPackage ./packages/tunarr.nix {};
    # Keep Jellyfin's server, web client, and patched FFmpeg together on the
    # locked unstable package set so upgrades move them as one unit.
    inherit (unstable) jellyfin jellyfin-web jellyfin-ffmpeg;
    # Pin only Plex's upstream binary until nixpkgs catches up; keep the
    # existing wrapper and dependencies without updating either input.
    plexRaw = prev.plexRaw.overrideAttrs (_: let
      version = "1.43.5.11079-b3b13e506";
    in {
      inherit version;
      src = prev.fetchurl {
        url = "https://downloads.plex.tv/plex-media-server-new/${version}/debian/plexmediaserver_${version}_amd64.deb";
        sha256 = "sha256-dOmnHJfgbW6SXMQ5gnkUH9g47p30RvkOdpYU+iyHogY=";
      };
    });
    t3code = final.callPackage ./packages/t3code.nix {};
    obsidian = final.callPackage ./packages/obsidian.nix {};
    cua-driver = final.callPackage ./packages/cua-driver.nix {};
    pi-config = final.callPackage ./packages/pi-config.nix {src = inputs.pi-config;};
    lazygit-nvim-edit = final.callPackage ./packages/lazygit-nvim-edit.nix {};
    # Stable Bun is older than the 1.3.14 the compiled CLI needs.
    workspaces = final.callPackage ./packages/workspaces/package.nix {
      inherit (unstable) bun;
      inherit (inputs.llm-agents.packages.${prev.stdenv.hostPlatform.system}) bun2nix;
    };
  })
]
