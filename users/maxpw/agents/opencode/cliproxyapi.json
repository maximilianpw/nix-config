{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "cliproxyapi",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    }
  ],
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  },
  "providers": {
    "cliproxyapi": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "compatibility": {
        "supportsPromptCacheKey": true
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra via CLIProxyAPI",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol via CLIProxyAPI",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna via CLIProxyAPI",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra via CLIProxyAPI",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          }
        }
      }
    }
  },
  "plugins": [
    "cc-safety-net",
    "@slkiser/opencode-quota"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fd *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "file *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git ls-files *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git remote *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git stash list",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jj status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian backlinks *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian file *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian files",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian files *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian folder *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian folders",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian folders *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian links *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian outline *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian properties *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian unresolved *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tree *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Documents/obsidian vault/**",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "executor": {
        "type": "remote",
        "url": "https://executor.maximilian.pw/mcp",
        "disabled": false
      }
    }
  }
}
