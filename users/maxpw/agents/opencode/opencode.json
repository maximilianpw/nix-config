{
  "$schema": "https://opencode.ai/config.json",
  "model": "cliproxyapi/gpt-5.6-sol",
  "provider": {
    "cliproxyapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "cliproxyapi-local-claudex",
        "setCacheKey": true
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol via CLIProxyAPI",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna via CLIProxyAPI",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra via CLIProxyAPI",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "plugin": [
    "cc-safety-net",
    "opencode-notify",
    "@simonwjackson/opencode-direnv",
    "@tarquinen/opencode-smart-title",
    "@slkiser/opencode-quota",
    "opencode-antigravity-auth@latest"
  ],
  "permission": {
    "bash": {
      "ls *": "allow",
      "pwd": "allow",
      "tree *": "allow",
      "which *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "jq *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "git ls-files *": "allow",
      "git stash list": "allow",
      "jj log *": "allow",
      "jj status": "allow",
      "jj diff *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "obsidian files": "allow",
      "obsidian files *": "allow",
      "obsidian file *": "allow",
      "obsidian folders": "allow",
      "obsidian folders *": "allow",
      "obsidian folder *": "allow",
      "obsidian backlinks *": "allow",
      "obsidian links *": "allow",
      "obsidian unresolved *": "allow",
      "obsidian outline *": "allow",
      "obsidian properties *": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "*": "ask"
    },
    "edit": "ask",
    "external_directory": {
      "~/Documents/obsidian vault/**": "allow"
    }
  },
  "mcp": {
    "executor": {
      "type": "remote",
      "url": "https://executor.liger-shilling.ts.net/mcp",
      "enabled": true
    }
  },
  "experimental": {
    "quotaToast": {
      "enableToast": false,
      "showSessionTokens": true,
      "enabledProviders": "auto",
      "formatStyle": "grouped",
      "percentDisplayMode": "remaining"
    }
  }
}
