{
  "displayName": "Maximilian PINDER-WHITE",
  "inboxTool": false,
  "inboxReminder": false,
  "inboxTailscale": false,
  "diffOptions": {
    "diffStyle": "split",
    "defaultDiffType": "since-base",
    "hideWhitespace": false,
    "diffIndicators": "bars",
    "overflow": "scroll",
    "lineBgIntensity": "subtle",
    "lineDiffType": "word-alt",
    "powerUp": true
  },
  "prompts": {
    "review": {
      "denied": "\n\nTreat the feedback above as human review input. Validate each finding against the code, then address confirmed issues without introducing unrelated changes. If a request is unclear, conflicts with the codebase, or cannot be applied safely, explain the issue and ask for clarification. Run the smallest relevant checks afterward and briefly summarize the changes and validation."
    }
  },
  "reviewAnalysis": {
    "semanticDiff": true,
    "callFlow": true
  },
  "agentTool": true,
  "reviewDefaults": {
    "jj": {
      "defaultDiffType": "jj-line"
    }
  },
  "theme": {
    "mode": "dark",
    "light": "plannotator",
    "dark": "plannotator"
  },
  "conventionalComments": true,
  "conventionalLabels": [
    {
      "label": "suggestion",
      "display": "suggestion",
      "blocking": true
    },
    {
      "label": "nitpick",
      "display": "nit",
      "blocking": true
    },
    {
      "label": "question",
      "display": "question",
      "blocking": true
    },
    {
      "label": "issue",
      "display": "issue",
      "blocking": true
    },
    {
      "label": "praise",
      "display": "praise",
      "blocking": false
    },
    {
      "label": "thought",
      "display": "thought",
      "blocking": false
    },
    {
      "label": "note",
      "display": "note",
      "blocking": false
    },
    {
      "label": "todo",
      "display": "todo",
      "blocking": true
    },
    {
      "label": "chore",
      "display": "chore",
      "blocking": true
    }
  ]
}
